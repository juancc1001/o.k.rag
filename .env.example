# Copy to .env and fill in the key for the provider you use.
# .env is gitignored. Only `okrag build` reads these — check, extract and
# `build --dry-run` never call a model.
#
# Which provider is used is set in okrag.toml under [synth].provider.

# --- Gemini (provider = "gemini") ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Anthropic (provider = "anthropic") ---
# https://platform.claude.com/settings/keys
# Optional: `ant auth login` stores a profile the SDK finds without any key.
# ANTHROPIC_API_KEY=

# --- Optional overrides ---
# Point at a proxy or gateway instead of the provider's default host.
# ANTHROPIC_BASE_URL=
# Verbose SDK logging when a call misbehaves: debug | info
# ANTHROPIC_LOG=
