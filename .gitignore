# derived, rebuildable from sources/ + bundle/
.ragged/

# your input corpus. Not committed: it is your own material, and a real corpus
# tends to carry third-party names that do not belong in a permanent history.
sources/

# working output. Not committed because concept ids derive from model-written
# titles, so every rebuild renames the whole tree and the diff is unreadable.
# A bundle worth showing goes in examples/ and is refreshed deliberately.
bundle/
okf-base.yaml

# layer 3, generated from the bundle on every build: AGENTS.md carries the
# corpus's own names for the same reason bundle/ is not committed, and the
# .mcp.json entry names the interpreter that generated it. `ragged agent`
# rewrites both. Anchored, or it would also swallow src/ragged/agent/.
/agent/
/.mcp.json

# secrets — .env.example is the committed template
.env

# per-user Claude Code config; skills under .claude/ are shared
.claude/settings.local.json

.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
